# Variables para el despliegue de producción (docker-compose.prod.yml).
# Copiar a ".env" en esta misma carpeta (junto a docker-compose.prod.yml) y
# poner valores reales. NUNCA subir el ".env" resultante a git.

# Generar con: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=cambiame-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=False

# IP (y/o dominio, si más adelante se agrega) por los que se accede a la app
DJANGO_ALLOWED_HOSTS=44.196.44.72

# Vacío: React y Django quedan bajo el mismo origen (mismo host:puerto) vía
# Nginx, no hace falta CORS.
CORS_ALLOWED_ORIGINS=

# Necesario para que /admin/ (login) funcione correctamente
CSRF_TRUSTED_ORIGINS=http://44.196.44.72:8010

# --- Base de datos (Postgres, servicio "db" del docker-compose.prod.yml) ---
DB_NAME=tableros
DB_USER=tableros
DB_PASSWORD=cambiame-por-una-contraseña-larga-y-aleatoria
